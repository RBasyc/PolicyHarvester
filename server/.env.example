# LLM 认证（二选一）
# 方式一：官方 API Key
ANTHROPIC_API_KEY=sk-ant-...
# 方式二：Bearer Token（Kimi 等 Anthropic 兼容网关）
# ANTHROPIC_AUTH_TOKEN=sk-kimi-...

# 可选：自定义 API 网关地址
# ANTHROPIC_BASE_URL=https://api.kimi.com/coding/

# 模型配置
MODEL_NAME=kimi-for-coding
MAX_TOKENS=16000

# 服务配置
HOST=0.0.0.0
PORT=8000

# MCP：chuance-policy 权威政策检索（默认启用，uvx stdio 启动，无需 API Key）
# MCP_CHUANCE_ENABLED=true
# MCP_CHUANCE_COMMAND=uvx
# MCP_CHUANCE_ARGS=["--from", "git+https://github.com/wenyi3370-lgtm/chuance-policy-mcp.git", "chuance-policy-mcp"]
