# 环境变量模板：位于仓库根目录。复制为同目录的 .env 后按需修改（server 会自动读取）。
#
# LLM 认证（二选一，切勿同时配置！）
#
# 方式一：官方 API Key（走 https://api.anthropic.com）
# ANTHROPIC_API_KEY=sk-ant-xxxx          # 注意：改成真实 Key，别留着 sk-ant-... 占位符，
#                                        # 否则请求会以 401 invalid x-api-key 被拒
#
# 方式二：Bearer Token（Kimi 等 Anthropic 兼容网关）
# ANTHROPIC_AUTH_TOKEN=sk-kimi-xxxx
# ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
#
# ⚠️ 走网关时如果环境里仍存在 ANTHROPIC_API_KEY，anthropic SDK 会同时发出
#    x-api-key 和 Authorization 两个头，网关将以 "invalid x-api-key" 拒绝。
# ⚠️ load_dotenv() 不覆盖已存在的环境变量：shell / 系统里若已设 ANTHROPIC_*，
#    本文件会被静默忽略（可用 `env | grep ANTHROPIC` 自查）。

# 模型配置
MODEL_NAME=kimi-for-coding
MAX_TOKENS=16000

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库：agent_demo（docker 容器 server-db-1，先执行 database/init.sh 初始化）
DATABASE_URL=postgresql://kos:kos@localhost:5433/agent_demo
# 可选：连接池大小
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# 抓取 / 提取流水线（可选，均有默认值）
# PIPELINE_MAX_POLICIES=10          # 单次任务最多处理多少篇
# PIPELINE_PER_KEYWORD_LIMIT=10     # 每个关键词向 MCP 请求多少条
# PIPELINE_EXTRACT_CONCURRENCY=1    # 并发提取篇数（1 = 顺序，日志/stage 语义最清晰）
# PIPELINE_MAX_BODY_CHARS=12000     # 送进大模型的正文上限
# PIPELINE_MCP_TIMEOUT=30           # 单次 MCP 调用超时秒数

# MCP：China-Central-Policy-MCP 国务院政策检索（默认启用，node stdio 启动本地构建产物，无需 API Key）
# MCP_POLICY_ENABLED=true
# MCP_POLICY_COMMAND=node
# MCP_POLICY_ARGS=["C:/path/to/Agent-Demo/tools/China-Central-Policy-MCP/build/index.js"]
