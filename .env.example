# 环境变量模板：位于仓库根目录。复制为同目录的 .env 后按需修改（server 会自动读取）。
#
# ── 模型：OpenAI 兼容协议 ─────────────────────────────────────────────
# 一切支持 /v1/chat/completions 的网关都同一个格式：DeepSeek、Moonshot（Kimi）、
# 官方 OpenAI、本地 vLLM / Ollama…… 换模型 / 换网关 = 只改下面三行。
# 认证只有一把 key（OpenAI SDK 以 Bearer 头发出，没有双头冲突问题）。
OPENAI_API_KEY=sk-your-deepseek-key   # 注意：改成真实 Key，别留占位符，否则会 401
OPENAI_BASE_URL=https://api.deepseek.com   # OpenAI 兼容端点（DeepSeek；也可写 https://api.deepseek.com/v1）
#
# ⚠️ load_dotenv() 不覆盖已存在的环境变量：shell / 系统里若已设 OPENAI_*，
#    本文件会被静默忽略（可用 `env | grep OPENAI` 自查）。

# 对话模型（/agent 页用）；下面 PIPELINE_MODELS 整行不配时它也是提取的兜底模型
MODEL_NAME=deepseek-flash
MAX_TOKENS=16000

# 提取模型注册表（页面「高级设置 → 提取模型」下拉框数据源；JSON 数组，热读，改完即生效无需重启）
# **加一个新模型 = 在数组里加一项**，每项字段：
#   id=稳定标识（落库到 crawl_task.pipeline_model）/ label=下拉框显示 /
#   model=发往 API 的模型名 /
#   base_url=不填 → 复用上面的 OPENAI_BASE_URL（同一网关只换模型名）/
#   api_key_env=不填 → 复用上面的 OPENAI_API_KEY；要另用一把 key 时，
#                先在下面加一行 XXX_API_KEY=...，再在这里填 "XXX_API_KEY" /
#   max_tokens=不填用上面 MAX_TOKENS / thinking=true 传 reasoning_effort="high"（默认关，提取够用）
# 第一项 = 默认模型（任务/定时任务不选时用它）。不配整行 = 单模型（只用 MODEL_NAME），与旧版一致。
# 跨网关示例（Kimi）：{"id":"kimi-k2","label":"Kimi K2","model":"kimi-k2-0711-preview",
#                     "base_url":"https://api.moonshot.cn/v1","api_key_env":"MOONSHOT_API_KEY"}
# PIPELINE_MODELS=[{"id":"deepseek-flash","label":"DeepSeek Flash","model":"deepseek-flash"},{"id":"deepseek-v4-pro","label":"DeepSeek V4 Pro","model":"deepseek-v4-pro"}]

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库：agent_demo（docker 容器 server-db-1，先执行 database/init.sh 初始化）
DATABASE_URL=postgresql://kos:kos@localhost:5433/agent_demo
# 可选：连接池大小
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# 抓取 / 提取流水线（可选，均有默认值）
# PIPELINE_MAX_POLICIES=10          # 单次任务最多处理多少篇（检索阶段按「新增篇数」凑满即停）
# PIPELINE_PER_KEYWORD_LIMIT=10     # 每次检索调用向 MCP 请求多少条（翻页续抓时即每页条数）
# PIPELINE_EXTRACT_CONCURRENCY=1    # 并发提取篇数（1 = 顺序，日志/stage 语义最清晰）
# PIPELINE_MAX_BODY_CHARS=12000     # 送进大模型的正文上限
# PIPELINE_MCP_TIMEOUT=30           # 单次 MCP 调用超时秒数
# PIPELINE_MAX_SEARCH_CALLS=12      # 检索 API 总调用预算（翻页续抓也计入；要用「续抓到 N 篇新增」建议调大，如 24-36）
# 正文预检（laya 判别之后的第二道筛，同样在检索阶段执行）：laya 通过的候选抓全文，
# 清洗后正文不达标的标「不建议入库」——拦图片版文件（抓回来的是 CSS/JS 页面壳）和
# 「现将《方案》印发给你们」式薄壳转发通知。阈值由 scripts/test_ingest_filter.py 校准
# （2026-10-13：好例 CJK≥1062/句末≥29，坏例句末≤1）。≤0 = 关闭对应信号；改后需重启。
# PIPELINE_MIN_BODY_CHARS=200        # 清洗后正文 CJK 字数下限
# PIPELINE_MIN_SENT_ENDERS=5         # 清洗后正文句末标点（。！？；）数下限
# PIPELINE_PREFLIGHT_CONCURRENCY=4   # 正文预检并发抓全文篇数

# MCP：China-Central-Policy-MCP 国务院政策检索（默认启用，node stdio 启动本地构建产物，无需 API Key）
# MCP_POLICY_ENABLED=true
# MCP_POLICY_COMMAND=node
# MCP_POLICY_ARGS=["C:/path/to/Agent-Demo/tools/China-Central-Policy-MCP/build/index.js"]

# 入库判别服务（judge · Phase 13）：检索阶段对候选篇目（仅标题）做「建议/不建议入库」标注，
# 在检索循环内逐页执行——被判「不建议」的不占 PIPELINE_MAX_POLICIES 名额，翻页继续凑建议入库的。
# 手动任务仅在前端提示「不建议入库」；定时任务自动剔除。本组配置改后需重启服务（非热读）。
# 服务不可达 / 超时 → fail-open：全部按建议入库处理，只在服务端日志告警。
# JUDGE_ENABLED=true
# JUDGE_URL=http://192.168.16.201:8084/v1/systemone
# JUDGE_TIMEOUT_SECONDS=5        # 单篇判别请求超时秒数
# JUDGE_CONCURRENCY=4            # 并发判别篇数
# JUDGE_KEEP_CHOICE=入库
# JUDGE_DROP_CHOICE=不入库
# JUDGE_INSTRUCTIONS=这篇文件属于哪一类？批复、函、人事任免、公告、会议纪要等事务性或礼节性文件选「不入库」；条例、办法、规定、规划、意见等具有长期执行效力的政策文件选「入库」。
#   ↑ **默认文案现在住在仓库根 prompts/judge.md**（2026-10-13 双轴矩阵两轮共 16 组合的冠军，
#   8/9 且唯一误判方向安全）；这里填了才覆盖它。调措辞直接改那个 md 即可，改完即刻生效。
#   state 只发标题——机关/文号会带偏该 RL 模型（文号含「函」直接被判不入库）。
#   想调措辞先跑 server/scripts/test_judge.py 对比，别凭语感改。

# 网站来源接入（Phase 14）：配置化抓取源的取数底座（app/sources/net.py）。
# 这些是**所有**来源共用的礼貌抓取与安全约束——不要为了让某次试运行「跑通」去放宽它们。
# 本组配置改后需重启服务（非热读）。单来源的抓取间隔可在配置里用 scope.request_interval_ms
# 覆写，但**只能调大不能调小**。详见 .claude/skills/website-source-onboarding/。
# SOURCE_FETCH_TIMEOUT=20              # 单次 HTTP 请求超时秒数（含详情页与附件）
# SOURCE_FETCH_MAX_BYTES=4000000       # 单个响应体字节上限，超出截断
# SOURCE_FETCH_MAX_REDIRECTS=5         # 重定向跳数上限（每一跳都重新做安全复验）
# SOURCE_FETCH_CONCURRENCY=4           # 全局同时在飞的请求数上限
# SOURCE_REQUEST_INTERVAL_MS=800       # 同一主机两次请求的最小间隔（0 = 不限，不建议关）
# SOURCE_RESPECT_ROBOTS=true           # 是否遵守 robots.txt（站点声明禁止 = 报「受阻」，不绕过）
# SOURCE_USER_AGENT=AgentDemo-SourceOnboarding/1.0 (+policy ingestion; contact: local demo)
# SOURCE_ALLOW_PRIVATE_HOSTS=false     # 是否允许取内网地址。**默认拒绝**（防 SSRF）；只在本机联调时临时打开
# SOURCE_LIST_CACHE_TTL=300            # 列表页缓存存活秒数（同一次检索内避免重复取同一页）
# SOURCE_ARTIFACT_DIR=server/.artifacts  # 原始附件落盘目录（原始文件是证据，不进版本库）
# SOURCE_MAX_ARTIFACTS_PER_RUN=20      # 单次试运行最多归档多少个附件（控体积与时长）；
#                                      # 试运行里附件的**抽查上限**是 min(3, 本值)

# 无头浏览器抓取（Phase 24）：Playwright + Chromium，用于 JS 渲染站点与「任意网站」临时抓取。
# 未安装时服务照常启动，只是「任意网站（无头浏览器）」来源与对话里的「浏览网页」开关不出现。
# 启用三步（在 server/ 目录执行）：
#   1) uv sync --extra browser          # 装 playwright（可选依赖 extra，不进默认依赖）
#   2) uv run playwright install chromium
#   3) 把下面的 BROWSER_ENABLED 改成 true（本组走 Settings，改完**需重启 server**）
# 安全口径：只读（非 GET/HEAD 一律拦截）、拦截内网/本机/云元数据地址、默认遵守 robots.txt、
# 每次运行用全新 BrowserContext。浏览器**不是** robots 的绕过手段——gov.cn 站内检索仍走 MCP。
# 抓取口径（UA / robots / 同主机间隔 / 私网开关）复用下面的 SOURCE_*。
# 数据出口：浏览到的页面内容会随发现循环/对话发给**已配置的模型网关**（与政策提取同一条链路）。
BROWSER_ENABLED=false                     # 总开关
# BROWSER_HEADLESS=true                   # 调试可设 false 看到 Chromium 窗口（服务器上别关）
# BROWSER_MAX_SESSIONS=2                  # 同时打开的浏览器上下文上限（交互 + 取全文共用）
# BROWSER_MAX_ACTIONS=20                  # 单次运行的动作预算（点击/输入/滚动/抽取都算）
# BROWSER_MAX_PAGES=10                    # 单次运行最多打开多少个页面
# BROWSER_MAX_EXTRACTS=10                 # 单次运行最多抽取多少篇正文
# BROWSER_TIMEOUT_SECONDS=300             # 单次运行的总时长上限
# BROWSER_NAVIGATION_TIMEOUT_MS=30000     # 单次导航超时
# BROWSER_MODEL=                          # 发现循环模型名；空 = MODEL_NAME。**必须支持工具调用**
# BROWSER_ALLOWED_DOMAINS=["www.news.cn","gov.cn"]   # 可选域名白名单（JSON 数组）；空 = 任意公网站点

# 可观测性：Langfuse / Litefuse（可选，**默认不上报**——下面的密钥不填就是关的）
# 用途：把对话图（含工具调用）与每篇政策的结构化提取都变成可视化的 trace，
# 排查「模型为什么这么答 / 这一步为什么慢 / 这次提取花了多少 token」。
# ⚠️ 这是**自托管**实例，trace 只发往你填的地址，不出本机——别把它换成云端地址。
# Litefuse 与 Langfuse 的 SDK 兼容，因此沿用 LANGFUSE_* 这套变量名。
# 本组走 Settings（进程启动时读取），改完**需重启 server**。任一项缺失即整体降级为不上报
# （开关关着 / 密钥为空 / 没装 langfuse 包），只在启动日志里说一句，绝不影响对话与抓取。
# LANGFUSE_ENABLED=true              # 总开关；密钥都配好了但不想上报时改 false
# LANGFUSE_PUBLIC_KEY=pk-lf-...      # Litefuse / Langfuse 项目设置里的公钥
# LANGFUSE_SECRET_KEY=sk-lf-...      # 同上，私钥。这两个是密钥，别提交进版本库
# LANGFUSE_BASE_URL=http://localhost:3000   # 服务地址。写成 LANGFUSE_HOST= 也认（两个名都收）
